<Page
    x:Class="MegasMoves.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="MegasMoves account and authorization">
        <StackPanel Padding="28,24,28,40" Spacing="18" MinWidth="720" MaxWidth="960" HorizontalAlignment="Left">
            <!-- 1. Desktop Page Header -->
            <StackPanel Spacing="3">
                <TextBlock Text="Account &amp; Identity"
                           FontFamily="{StaticResource MegasDisplayFontFamily}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="Sign-in manages MegasMoves account access without altering local workspace permissions."
                           FontFamily="{StaticResource MegasUiFontFamily}"
                           FontSize="13"
                           Foreground="{ThemeResource MegasMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Error InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     IsClosable="False"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     CornerRadius="6"
                     AutomationProperties.Name="Account or authorization failure"
                     AutomationProperties.LiveSetting="Assertive" />

            <!-- Thin Separator -->
            <Border Style="{StaticResource DesktopSeparatorStyle}" />

            <!-- 2. Linked Identity Surface -->
            <Border Style="{StaticResource DesktopSurfaceStyle}" Padding="20,16">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{ThemeResource MegasAccentSoftBrush}"
                                BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                BorderThickness="1">
                            <FontIcon Glyph="&#xE77B;"
                                      Foreground="{ThemeResource MegasAccentBrush}"
                                      FontSize="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AccountDisplay, Mode=OneWay}"
                                       FontFamily="{StaticResource MegasDisplayFontFamily}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Linked account identity" />
                            <TextBlock Text="{x:Bind ViewModel.AccountDetail, Mode=OneWay}"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="12"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Account status -->
                        <Border Grid.Column="2"
                                Style="{StaticResource PillBadgeBorderStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource MegasMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.McpStripText, Mode=OneWay}"
                                           FontFamily="{StaticResource MegasUiFontFamily}"
                                           Foreground="{ThemeResource MegasBadgeTextBrush}"
                                           FontWeight="Medium"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="Account status" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Identity Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SignInCommand}"
                                Visibility="{x:Bind SignInVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Sign in with Amretra">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77B;" FontSize="12" />
                                <TextBlock Text="Sign in with Amretra" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.SignOutCommand}"
                                Visibility="{x:Bind SignOutVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Sign out">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xF3B1;" FontSize="12" />
                                <TextBlock Text="Sign out" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                AutomationProperties.Name="Refresh account state">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Thin Separator -->
            <Border Style="{StaticResource DesktopSeparatorStyle}" />

            <!-- 3. Security & Machine Sovereignty -->
            <Grid ColumnSpacing="16" MinWidth="680">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Panel 1: Windows DPAPI -->
                <Border Style="{StaticResource DesktopSurfaceStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="{ThemeResource MegasAccentBrush}" />
                            <TextBlock Text="Windows DPAPI Security" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="Credentials and access tokens remain safeguarded using Windows DPAPI storage tied to your user profile. MegasMoves never persists plaintext bearer tokens."
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource MegasMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="DPAPI Enforced" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource MegasBadgeTextBrush}" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="Zero Plaintext Storage" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource MegasBadgeTextBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Panel 2: Offline Local Sovereignty -->
                <Border Grid.Column="1" Style="{StaticResource DesktopSurfaceStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource MegasAccentBrush}" />
                            <TextBlock Text="Local Sovereignty" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="Trusted repositories, dev-servers, port inspections, normalized tests, and ADB device automation are strictly machine-local and work offline without sign-in."
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource MegasMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="100% Local Testing" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource MegasBadgeTextBrush}" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="Folder Trust Guard" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource MegasBadgeTextBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
