<Page
    x:Class="MegasMoves.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegasMoves.ViewModels"
    Background="Transparent">

    <Grid Padding="28,24,28,36" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Desktop Page Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Activity"
                           FontFamily="{StaticResource MegasDisplayFontFamily}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="Chronological event browser across agents, MCP, devices, and runtimes."
                           FontFamily="{StaticResource MegasUiFontFamily}"
                           FontSize="13"
                           Foreground="{ThemeResource MegasMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="18"
                              Height="18"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              AutomationProperties.Name="Activity query in progress" />
                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="Refresh Activity snapshot">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Click="Export_Click"
                        AutomationProperties.Name="Export visible Activity as JSON">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Thin Separator -->
        <Border Grid.Row="1" Style="{StaticResource DesktopSeparatorStyle}" />

        <!-- 2. Desktop Filter Bar -->
        <Grid Grid.Row="2" ColumnSpacing="10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryBox"
                     PlaceholderText="Filter activity, operations, tools…"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                     KeyDown="QueryBox_KeyDown"
                     CornerRadius="6"
                     Height="32"
                     FontSize="12"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="Search Activity" />

            <ComboBox Grid.Column="1"
                      PlaceholderText="All sources"
                      ItemsSource="{x:Bind ViewModel.Sources}"
                      SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}"
                      CornerRadius="6"
                      Height="32"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Activity source filter" />

            <CheckBox Grid.Column="2"
                      Content="Errors only"
                      IsChecked="{x:Bind ViewModel.ErrorsOnly, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="4,0,0,0"
                      AutomationProperties.Name="Show errors only" />

            <ToggleSwitch x:Name="FollowToggle"
                          Grid.Column="3"
                          OffContent="Paused"
                          OnContent="Live"
                          IsOn="True"
                          VerticalAlignment="Center"
                          Margin="4,0,0,0"
                          Toggled="FollowToggle_Toggled"
                          AutomationProperties.Name="Follow live Activity" />

            <Button Grid.Column="4"
                    Content="Apply"
                    Click="ApplyFilters_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    Height="32"
                    Padding="12,0" />

            <Button Grid.Column="5"
                    Content="Clear"
                    Click="ClearFilters_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    VerticalAlignment="Center"
                    Height="32"
                    Padding="12,0" />
        </Grid>

        <!-- Error InfoBar if required -->
        <InfoBar Grid.Row="3"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 IsClosable="False"
                 Title="Activity connection failed"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 CornerRadius="6"
                 AutomationProperties.Name="Activity connection error"
                 AutomationProperties.LiveSetting="Polite" />

        <!-- 3. Chronological Event Table -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Grid Padding="12,6"
                  BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                  BorderThickness="0,0,0,1"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  CornerRadius="4,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Timestamp" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                <TextBlock Grid.Column="1" Text="Source" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                <TextBlock Grid.Column="2" Text="State" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                <TextBlock Grid.Column="3" Text="Event / Action" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                <TextBlock Grid.Column="4" Text="Correlation" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
            </Grid>

            <ListView x:Name="ActivityList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      AutomationProperties.Name="Structured Activity timeline">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="38" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityItemViewModel">
                        <Border Style="{StaticResource DesktopTableRowBorderStyle}" Padding="12,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copy event line" Click="CopySelected_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" MinWidth="240" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Time}"
                                           FontSize="11"
                                           FontFamily="{StaticResource MegasMonoFontFamily}"
                                           Foreground="{ThemeResource MegasMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind Source}"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource MegasBadgeTextBrush}"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind State}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Message}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind Operation}"
                                           FontSize="10"
                                           FontFamily="{StaticResource MegasMonoFontFamily}"
                                           Foreground="{ThemeResource MegasMutedBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 4. Quiet Status Footer -->
        <TextBlock Grid.Row="5"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   FontSize="11"
                   Foreground="{ThemeResource MegasMutedBrush}"
                   VerticalAlignment="Center" />
    </Grid>
</Page>
