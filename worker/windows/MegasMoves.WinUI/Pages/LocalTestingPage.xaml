<Page
    x:Class="MegasMoves.Pages.LocalTestingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegasMoves.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="MegasMoves Operations workbench">
        <StackPanel Padding="28,24,28,40" Spacing="18" MinWidth="800">
            <!-- 1. Desktop Page Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Operations"
                               FontFamily="{StaticResource MegasDisplayFontFamily}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Repository-evidenced local testing, runnable targets, services, and execution boundaries."
                               FontFamily="{StaticResource MegasUiFontFamily}"
                               FontSize="13"
                               Foreground="{ThemeResource MegasMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Add Product Folder"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddFolder_Click"
                            AutomationProperties.Name="Add trusted product folder" />
                    <Button Content="Refresh"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.Name="Refresh Local Testing state" />
                </StackPanel>
            </Grid>

            <!-- Error InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     IsClosable="False"
                     Title="Operation failed"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     CornerRadius="6"
                     AutomationProperties.LiveSetting="Assertive" />

            <!-- Thin Separator -->
            <Border Style="{StaticResource DesktopSeparatorStyle}" />

            <!-- 2. Compact Operational Status Strip -->
            <Border Style="{StaticResource DesktopSurfaceStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="STATUS"
                                   FontFamily="{StaticResource MegasUiFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource MegasMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Products / Targets" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.TrustedProjectCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="products ·" FontSize="12" Foreground="{ThemeResource MegasMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RunnableTargetCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="targets" FontSize="12" Foreground="{ThemeResource MegasMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Active Services" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource MegasAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.RunningServiceCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="running" FontSize="12" Foreground="{ThemeResource MegasMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Android Target" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ReadyDeviceCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="ready" FontSize="12" Foreground="{ThemeResource MegasMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Target Selection / Device Binding -->
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Android actions use the selected connected device. Native Windows and Web targets run on local host."
                           FontSize="12"
                           Foreground="{ThemeResource MegasMutedBrush}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Model"
                          PlaceholderText="Select Android device"
                          CornerRadius="6"
                          Height="32"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Android device for Local Testing run" />
            </Grid>

            <!-- Thin Separator -->
            <Border Style="{StaticResource DesktopSeparatorStyle}" />

            <!-- 4. Trusted Products Table -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TRUSTED PRODUCTS"
                               FontFamily="{StaticResource MegasUiFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               CharacterSpacing="60"
                               Foreground="{ThemeResource MegasMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Human folder trust boundary"
                               FontSize="11"
                               Foreground="{ThemeResource MegasMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Table Header -->
                <Grid Padding="12,6"
                      BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                      BorderThickness="0,0,0,1"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      CornerRadius="4,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Project Name" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Local Path" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="Targets" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="Services" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="Preflight" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                               AutomationProperties.Name="Trusted Local Testing products">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalTestingProjectItemViewModel">
                            <Border Style="{StaticResource DesktopTableRowBorderStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind StateSummary}" FontSize="10" Foreground="{ThemeResource MegasMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Root}"
                                               FontFamily="{StaticResource MegasMonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{ThemeResource MegasMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TargetSummary}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ServiceSummary}" FontSize="12" VerticalAlignment="Center" />
                                    <Button Grid.Column="4"
                                            Content="Check"
                                            Padding="10,4"
                                            MinHeight="28"
                                            Click="ProjectCheckClicked"
                                            AutomationProperties.Name="Check trusted product prerequisites" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Thin Separator -->
            <Border Style="{StaticResource DesktopSeparatorStyle}" />

            <!-- 5. Runnable Targets Table -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RUNNABLE TARGETS"
                               FontFamily="{StaticResource MegasUiFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               CharacterSpacing="60"
                               Foreground="{ThemeResource MegasMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Web · Windows · Android · Service"
                               FontSize="11"
                               Foreground="{ThemeResource MegasMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Table Header -->
                <Grid Padding="12,6"
                      BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                      BorderThickness="0,0,0,1"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      CornerRadius="4,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Project" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Target" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="Type" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="Runtime" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="Evidence" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="5" Text="Actions" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                               AutomationProperties.Name="All proven runnable targets">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalTestingTargetItemViewModel">
                            <Border Style="{StaticResource DesktopTableRowBorderStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Project}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind StateLabel}" FontSize="10" Foreground="{ThemeResource MegasMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Id}"
                                                   FontFamily="{StaticResource MegasMonoFontFamily}"
                                                   FontSize="9"
                                                   Foreground="{ThemeResource MegasMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind TypeLabel}" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource MegasBadgeTextBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{x:Bind RuntimeLabel}" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind Evidence}"
                                               FontFamily="{StaticResource MegasMonoFontFamily}"
                                               FontSize="10"
                                               Foreground="{ThemeResource MegasMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="{x:Bind BuildLabel}"
                                                Padding="8,3"
                                                MinHeight="28"
                                                FontSize="11"
                                                IsEnabled="{x:Bind CanBuild}"
                                                Click="TargetBuildClicked" />
                                        <Button Content="{x:Bind OpenLabel}"
                                                Padding="8,3"
                                                MinHeight="28"
                                                FontSize="11"
                                                IsEnabled="{x:Bind CanOpen}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="TargetOpenClicked" />
                                        <Button Content="Logs"
                                                Padding="8,3"
                                                MinHeight="28"
                                                FontSize="11"
                                                IsEnabled="{x:Bind CanReadAndroidLogs}"
                                                Click="TargetLogsClicked" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Thin Separator -->
            <Border Style="{StaticResource DesktopSeparatorStyle}" />

            <!-- 6. Runtime Services Table -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RUNTIME SERVICES"
                               FontFamily="{StaticResource MegasUiFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               CharacterSpacing="60"
                               Foreground="{ThemeResource MegasMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="PID · Ports · Health URLs"
                               FontSize="11"
                               Foreground="{ThemeResource MegasMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Table Header -->
                <Grid Padding="12,6"
                      BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                      BorderThickness="0,0,0,1"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      CornerRadius="4,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Project" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Service Name" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="State" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="PID" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="Ports" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="5" Text="Local URL" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="6" Text="Actions" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}"
                               AutomationProperties.Name="Local runtime services">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalTestingServiceItemViewModel">
                            <Border Style="{StaticResource DesktopTableRowBorderStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Project}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind StateLabel}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Pid}" FontFamily="{StaticResource MegasMonoFontFamily}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Ports}" FontFamily="{StaticResource MegasMonoFontFamily}" FontSize="10" Foreground="{ThemeResource MegasMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind OpenUrl}" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="Start"
                                                Padding="8,3"
                                                MinHeight="28"
                                                FontSize="11"
                                                IsEnabled="{x:Bind CanStart}"
                                                Click="ServiceStartClicked" />
                                        <Button Content="Stop"
                                                Padding="8,3"
                                                MinHeight="28"
                                                FontSize="11"
                                                IsEnabled="{x:Bind CanStop}"
                                                Click="ServiceStopClicked" />
                                        <Button Content="Logs"
                                                Padding="8,3"
                                                MinHeight="28"
                                                FontSize="11"
                                                Click="ServiceLogsClicked" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Clean empty state for services -->
                <Border Visibility="{x:Bind ServiceEmptyVisibility, Mode=OneWay}"
                        Padding="14,10"
                        BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="No declared local runtime services for current trusted products."
                               FontSize="12"
                               Foreground="{ThemeResource MegasMutedBrush}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
