<Page
    x:Class="MegasMoves.Pages.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegasMoves.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,0,24,0"
              Height="56"
              Background="{ThemeResource MegasWorkbenchChromeBrush}"
              BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Runtime" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Trusted products, runnable surfaces, services, ports and attached devices."
                           FontSize="12"
                           Foreground="{ThemeResource MegasMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}"
                        Click="AddFolder_Click"
                        AutomationProperties.Name="Add trusted software folder">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        <TextBlock Text="Add trusted folder" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="Refresh runtime state">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource MegasTitleBarGlassBrush}"
                    BorderBrush="{ThemeResource MegasCardGlassBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="12,0,8,0"
                          BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TRUSTED PRODUCTS"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.TrustedProjectCount, Mode=OneWay}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="9"
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBox x:Name="ProjectFilterBox"
                             Grid.Row="1"
                             Margin="8,7,8,5"
                             Height="32"
                             PlaceholderText="Filter products"
                             TextChanged="ProjectFilterBox_TextChanged"
                             AutomationProperties.Name="Filter trusted products" />

                    <ListView x:Name="ProjectPicker"
                              Grid.Row="2"
                              Margin="4,0"
                              ItemsSource="{x:Bind FilteredProjects, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectionChanged="ProjectPicker_SelectionChanged"
                              IsItemClickEnabled="False"
                              AutomationProperties.Name="Trusted product navigator">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="50" />
                                <Setter Property="CornerRadius" Value="5" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectCardViewModel">
                                <Grid Padding="9,6" ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Root}"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="8"
                                                   Foreground="{ThemeResource MegasMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind State}"
                                               FontSize="9"
                                               Foreground="{ThemeResource MegasMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="3"
                            Padding="10,8"
                            BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Local testing policy"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Repository-evidenced actions only. Folder trust stays human-controlled."
                                       FontSize="9"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <InfoBar Margin="20,12,20,0"
                         VerticalAlignment="Top"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         IsClosable="False"
                         Title="Runtime action failed"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         AutomationProperties.LiveSetting="Polite"
                         AutomationProperties.Name="Runtime action failure" />

                <ScrollViewer Visibility="{x:Bind ProjectDetailVisibility, Mode=OneWay}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="720" Padding="24,22,28,44" Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind SelectedProjectName, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind SelectedProjectRoot, Mode=OneWay}"
                                           FontFamily="{StaticResource MegasMonoFontFamily}"
                                           FontSize="10"
                                           Foreground="{ThemeResource MegasMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="7"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource PillBadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind SelectedProjectState, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource MegasBadgeTextBrush}" />
                                </Border>
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Click="OpenSelected_Click"
                                        AutomationProperties.Name="Open selected product target">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BuildSelected_Click"
                                        AutomationProperties.Name="Build or start selected product target">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                                        <TextBlock Text="Build / Start" />
                                    </StackPanel>
                                </Button>
                                <Button Click="CheckSelected_Click"
                                        AutomationProperties.Name="Run selected product preflight">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="11" />
                                        <TextBlock Text="Check" />
                                    </StackPanel>
                                </Button>
                                <Button Click="StopSelected_Click"
                                        AutomationProperties.Name="Stop selected product service">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71A;" FontSize="11" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="0"
                              Background="{ThemeResource MegasWorkbenchPanelBrush}"
                              BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                              BorderThickness="1"
                              CornerRadius="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Padding="13,10" Spacing="2">
                                <TextBlock Text="{x:Bind SelectedTargetSummary, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="Runnable surfaces" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Padding="13,10" Spacing="2">
                                <TextBlock Text="{x:Bind SelectedServiceSummary, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="Declared services" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Padding="13,10" Spacing="2">
                                <TextBlock Text="{x:Bind SelectedTargetLabel, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Preferred target" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Padding="13,10" Spacing="2">
                                <TextBlock Text="{x:Bind SelectedLastAction, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Latest local action" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" />
                            </StackPanel>
                        </Grid>

                        <TabView IsAddTabButtonVisible="False"
                                 AutomationProperties.Name="Selected product runtime details">
                            <TabViewItem Header="Surfaces">
                                <StackPanel Padding="2,18,2,4" Spacing="0">
                                    <TextBlock Text="RUNNABLE SURFACE"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="70"
                                               Foreground="{ThemeResource MegasMutedBrush}"
                                               Margin="0,0,0,8" />
                                    <Border BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid Padding="0,11" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Kind" Foreground="{ThemeResource MegasMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SelectedTargetKind, Mode=OneWay}" FontFamily="Cascadia Mono" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SelectedTargetSummary, Mode=OneWay}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid Padding="0,11" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Target" Foreground="{ThemeResource MegasMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SelectedTargetLabel, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                            BorderThickness="0,1,0,1">
                                        <Grid Padding="0,11" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Service" Foreground="{ThemeResource MegasMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SelectedServiceName, Mode=OneWay}" FontFamily="Cascadia Mono" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </TabViewItem>

                            <TabViewItem Header="Services">
                                <StackPanel Padding="2,18,2,4" Spacing="8">
                                    <ItemsRepeater ItemsSource="{x:Bind SelectedServices, Mode=OneWay}"
                                                   AutomationProperties.Name="Selected product services">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="0" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RuntimeServiceViewModel">
                                                <Border BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,10">
                                                    <Grid ColumnSpacing="14" MinWidth="680">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="105" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="145" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Service}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Project}" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind State}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Pid}" FontFamily="Cascadia Mono" FontSize="10" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind Ports}" FontFamily="Cascadia Mono" FontSize="10" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="4" Spacing="2">
                                                            <TextBlock Text="{x:Bind OpenUrl}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind HealthUrl}" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock Text="Raw service output is intentionally one level deeper under Advanced."
                                               FontSize="10"
                                               Foreground="{ThemeResource MegasMutedBrush}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </TabViewItem>

                            <TabViewItem Header="Devices">
                                <StackPanel Padding="2,18,2,4" Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Attached Android targets" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AdbState, Mode=OneWay}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource MegasMutedBrush}" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                                   AutomationProperties.Name="Bounded ADB device targets">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="0" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                                <Border BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,10">
                                                    <Grid ColumnSpacing="14" MinWidth="600">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Serial}" FontFamily="Cascadia Mono" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Connection}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind State}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </TabViewItem>

                            <TabViewItem Header="Terminals">
                                <StackPanel Padding="2,18,2,4" Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Concurrent Terminal Sessions" FontWeight="SemiBold" />
                                            <TextBlock Text="Add and manage any number of background processes, streamed live to Android and Megas MCP."
                                                       FontSize="10"
                                                       Foreground="{ThemeResource MegasMutedBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="NewTerminal_Click"
                                                AutomationProperties.Name="Spawn new terminal session">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE756;" FontSize="11" />
                                                <TextBlock Text="New terminal" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Spawn Input Box -->
                                    <Grid x:Name="NewTerminalPanel" Visibility="Collapsed" ColumnSpacing="8" Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewTerminalCommandBox"
                                                 PlaceholderText="Enter command to spawn (e.g. npm test, ping 127.0.0.1, python script.py)"
                                                 FontFamily="Cascadia Mono"
                                                 FontSize="11" />
                                        <Button Grid.Column="1"
                                                Click="SpawnTerminal_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="Run terminal command">
                                            <TextBlock Text="Run" />
                                        </Button>
                                        <Button Grid.Column="2"
                                                Click="CancelNewTerminal_Click"
                                                AutomationProperties.Name="Cancel terminal spawn">
                                            <TextBlock Text="Cancel" />
                                        </Button>
                                    </Grid>

                                    <!-- Terminals List -->
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Terminals, Mode=OneWay}"
                                                   AutomationProperties.Name="Active terminal sessions">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="0" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TerminalSessionViewModel">
                                                <Border BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,10">
                                                    <Grid ColumnSpacing="12" MinWidth="680">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind SessionId}" FontFamily="Cascadia Mono" FontSize="9" Foreground="{ThemeResource MegasMutedBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Command}" FontFamily="Cascadia Mono" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource PillBadgeBorderStyle}">
                                                            <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Command="{x:Bind RefreshOutputCommand}"
                                                                    ToolTipService.ToolTip="Refresh live output"
                                                                    AutomationProperties.Name="Refresh output">
                                                                <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                                            </Button>
                                                            <Button Command="{x:Bind TerminateCommand}"
                                                                    IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                                                    ToolTipService.ToolTip="Stop session"
                                                                    AutomationProperties.Name="Stop terminal session">
                                                                <FontIcon Glyph="&#xE71A;" FontSize="11" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </TabViewItem>
                        </TabView>
                    </StackPanel>
                </ScrollViewer>

                <Grid Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="520">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="30"
                                  Foreground="{ThemeResource MegasAccentBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Add a trusted product"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="MegasMoves will inspect repository evidence, find safe runnable surfaces and refuse to invent arbitrary commands."
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Button HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="AddFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                <TextBlock Text="Add trusted folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Visibility="{x:Bind SelectionPromptVisibility, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="460">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <TextBlock Text="No matching product"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Clear the product filter or choose another trusted product."
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
