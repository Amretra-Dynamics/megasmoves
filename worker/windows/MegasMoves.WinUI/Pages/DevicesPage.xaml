<Page
    x:Class="MegasMoves.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegasMoves.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="MegasMoves Devices">
        <StackPanel Padding="28,24,28,40" Spacing="18" MinWidth="740">
            <!-- 1. Desktop Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Devices"
                               FontFamily="{StaticResource MegasDisplayFontFamily}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Attached Android devices, emulators, and local execution targets."
                               FontFamily="{StaticResource MegasUiFontFamily}"
                               FontSize="13"
                               Foreground="{ThemeResource MegasMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Refresh attached ADB devices">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Thin Separator -->
            <Border Style="{StaticResource DesktopSeparatorStyle}" />

            <!-- 2. ADB Transport Status Strip -->
            <Border Style="{StaticResource DesktopSurfaceStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="ADB TRANSPORT STATUS"
                                   FontFamily="{StaticResource MegasUiFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource MegasMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AdbState, Mode=OneWay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   AutomationProperties.Name="Current ADB status" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource PillBadgeBorderStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ReadyDeviceCount, Mode=OneWay}"
                                       Foreground="{ThemeResource MegasBadgeTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="Ready Android device count" />
                            <TextBlock Text="ready"
                                       Foreground="{ThemeResource MegasBadgeTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Physical Devices Table -->
            <StackPanel Spacing="8">
                <TextBlock Text="DETECTED TARGETS"
                           FontFamily="{StaticResource MegasUiFontFamily}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           CharacterSpacing="60"
                           Foreground="{ThemeResource MegasMutedBrush}" />

                <!-- Table Header -->
                <Grid Padding="12,6"
                      BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                      BorderThickness="0,0,0,1"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      CornerRadius="4,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Model / Device" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Serial Number" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="Connection" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="ADB State" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasMutedBrush}" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                               AutomationProperties.Name="Detected bounded ADB targets">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                            <Border Style="{StaticResource DesktopTableRowBorderStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Model}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Serial}"
                                               FontFamily="{StaticResource MegasMonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{ThemeResource MegasMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Connection}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{ThemeResource MegasSuccessBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind State}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- 4. Quiet Guidance Footnote -->
            <Border Padding="14,10"
                    BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <TextBlock Text="device = ready for MegasMoves deployment · unauthorized = approve this computer in Android's USB debugging prompt · offline = reconnect transport or restart ADB server."
                           FontSize="11"
                           Foreground="{ThemeResource MegasMutedBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
