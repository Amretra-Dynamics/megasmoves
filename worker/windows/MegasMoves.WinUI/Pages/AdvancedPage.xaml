<Page
    x:Class="MegasMoves.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegasMoves.ViewModels"
    Background="Transparent">

    <Grid Padding="32,28,32,36" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5">
            <TextBlock Text="Advanced" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Deeper evidence for debugging: raw service output, ports, devices, agent connections and trust diagnostics."
                       FontSize="14"
                       Foreground="{ThemeResource MegasMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TabView Grid.Row="1" IsAddTabButtonVisible="False">
            <TabViewItem Header="Raw logs">
                <Grid Padding="2,18,2,2" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="ServicePicker"
                                  PlaceholderText="Declared service"
                                  ItemsSource="{x:Bind Main.RuntimeServices, Mode=OneWay}"
                                  SelectionChanged="ServicePicker_SelectionChanged"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Service log source">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeServiceViewModel">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Service}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Project}" FontSize="10" Foreground="{ThemeResource MegasMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox x:Name="RawSearchBox"
                                 Grid.Column="1"
                                 PlaceholderText="Search text in bounded output…"
                                 Text="{x:Bind Diagnostics.RawLogSearch, Mode=TwoWay}"
                                 KeyDown="RawSearchBox_KeyDown"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Search raw service logs" />

                        <Button Grid.Column="2"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="LoadLogs_Click"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Load bounded raw service logs">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="11" />
                                <TextBlock Text="Load" />
                            </StackPanel>
                        </Button>

                        <ToggleSwitch x:Name="RawFollowToggle"
                                      Grid.Column="3"
                                      OffContent="Off"
                                      OnContent="Follow"
                                      VerticalAlignment="Center"
                                      Margin="4,0,0,0"
                                      Toggled="RawFollowToggle_Toggled"
                                      AutomationProperties.Name="Follow raw service logs using event notifications" />

                        <ProgressRing Grid.Column="4"
                                      Width="20"
                                      Height="20"
                                      IsActive="{x:Bind Diagnostics.IsBusy, Mode=OneWay}"
                                      VerticalAlignment="Center"
                                      Margin="4,0,0,0"
                                      AutomationProperties.Name="Raw log operation progress" />
                    </Grid>

                    <InfoBar Grid.Row="1"
                             IsOpen="{x:Bind Diagnostics.HasError, Mode=OneWay}"
                             Severity="Error"
                             IsClosable="False"
                             Title="Raw log read failed"
                             Message="{x:Bind Diagnostics.ErrorMessage, Mode=OneWay}"
                             AutomationProperties.LiveSetting="Polite" />

                    <Border Grid.Row="2"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="14,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Diagnostics.RawLogTitle, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Diagnostics.RawLogStatus, Mode=OneWay}"
                                           Margin="12,0"
                                           FontSize="11"
                                           Foreground="{ThemeResource MegasMutedBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Raw log follow status" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Diagnostics.RawLogLines, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource MegasMutedBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="Visible raw log line count" />
                            </Grid>
                            <TextBox Grid.Row="1"
                                     Text="{x:Bind Diagnostics.DisplayedRawLogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Cascadia Mono"
                                     FontSize="12"
                                     BorderThickness="0"
                                     Padding="14"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Bounded redacted raw service log" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Raw output is capped at 500 lines, redacted by the trusted runtime, and Follow waits on managed log-file change notifications instead of polling."
                                   FontSize="11"
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="ClearRawSearch_Click" Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE894;" FontSize="11" />
                                    <TextBlock Text="Clear" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopyRawLogs_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    <TextBlock Text="Copy view" />
                                </StackPanel>
                            </Button>
                            <Button Click="ExportRawLogs_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="11" />
                                    <TextBlock Text="Export view" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Ports &amp; services">
                <ScrollViewer Padding="2,18,2,2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <ItemsRepeater ItemsSource="{x:Bind Main.RuntimeServices, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="9" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeServiceViewModel">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="15,13">
                                        <Grid ColumnSpacing="14" MinWidth="720">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" MinWidth="160" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Project}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Service}" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind State}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Pid}" FontFamily="Cascadia Mono" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Ports}" FontFamily="Cascadia Mono" FontSize="11" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Spacing="2">
                                                <TextBlock Text="{x:Bind OpenUrl}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind HealthUrl}" FontSize="10" Foreground="{ThemeResource MegasMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Devices">
                <ScrollViewer Padding="2,18,2,2">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ADB" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Main.AdbState, Mode=OneWay}" Foreground="{ThemeResource MegasMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Main.ReadyDeviceCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ItemsRepeater ItemsSource="{x:Bind Main.Devices, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="9" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="15,13">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Serial}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{ThemeResource MegasMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Connection}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind State}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock Text="Arbitrary ADB shell input is intentionally not exposed. Pair/connect/run actions remain reviewed typed operations."
                                   FontSize="11"
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Connections">
                <ScrollViewer Padding="2,18,2,2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <ItemsRepeater ItemsSource="{x:Bind Main.Agents, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="9" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AgentItemViewModel">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="15,13">
                                        <Grid ColumnSpacing="14" MinWidth="640">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" MinWidth="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Detection}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Connection}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Configuration}" Foreground="{ThemeResource MegasMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border Style="{StaticResource CardBorderStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Local IPC" FontWeight="SemiBold" />
                                <TextBlock Text="WinUI connects to the Python operator through per-launch authenticated Windows named pipes. Command, Activity and raw-log subscriptions are separate typed transports; remote clients are rejected."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource MegasMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Diagnostics">
                <ScrollViewer Padding="2,18,2,2">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Runtime registry" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Main.MachineState, Mode=OneWay}" />
                                <TextBlock Text="MCP runtime state remains authoritative in the Python capability core."
                                           Foreground="{ThemeResource MegasMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Folder trust" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Human controlled" FontWeight="SemiBold" Foreground="{ThemeResource MegasSuccessBrush}" />
                                <TextBlock Text="Agents operate only folders already trusted through MegasMoves."
                                           Foreground="{ThemeResource MegasMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Permissions" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Typed capabilities only" FontWeight="SemiBold" />
                                <TextBlock Text="No arbitrary shell, raw argv, raw SQL or arbitrary ADB shell is exposed to agents."
                                           Foreground="{ThemeResource MegasMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Operational persistence" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Main.DbStripText, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="The UI does not create a second authority. Storage migration must preserve canonical MCP state and deterministic recovery."
                                           Foreground="{ThemeResource MegasMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Native architecture" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="WinUI 3 / C# → authenticated named-pipe operator client → Python Megas MCP authority; C++20 machine primitives enter through versioned C ABI v1."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Native callbacks are queued before UI work and normalized back into canonical Activity."
                                           Foreground="{ThemeResource MegasMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>