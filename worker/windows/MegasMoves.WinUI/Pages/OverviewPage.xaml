<Page
    x:Class="MegasMoves.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegasMoves.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="MegasMoves Overview">
        <StackPanel Padding="28,24,28,40" Spacing="20" MinWidth="740">
            <!-- 1. Hero Stage (CleanMyMac-style Smart Care Centerpiece) -->
            <Border Style="{StaticResource HeroCardStyle}">
                <Grid ColumnSpacing="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Concentric Radiant Status Dial (CleanMyMac Crown Jewel) -->
                    <Grid Width="116" Height="116" VerticalAlignment="Center">
                        <!-- Outer Ambient Glow Disc -->
                        <Ellipse Width="116" Height="116"
                                 Fill="{ThemeResource MegasDialGlowBrush}"
                                 Opacity="0.65" />
                        <!-- Outer Orbital Dashed Precision Track -->
                        <Ellipse Width="108" Height="108"
                                 Stroke="{ThemeResource MegasAccentStrongBrush}"
                                 StrokeThickness="1.5"
                                 StrokeDashArray="4,2"
                                 Opacity="0.5" />
                        <!-- Mid Radiant Orbital Ring -->
                        <Ellipse Width="92" Height="92"
                                 Stroke="{ThemeResource MegasAccentBrush}"
                                 StrokeThickness="2.5"
                                 Opacity="0.9" />
                        <!-- Inner Obsidian Core Plate -->
                        <Border Width="72" Height="72"
                                CornerRadius="36"
                                Background="{ThemeResource MegasCardGlassBrush}"
                                BorderBrush="{ThemeResource MegasAccentBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="28"
                                      Foreground="{ThemeResource MegasAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Status Typography & Verification Badges -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="All Systems Nominal"
                                       FontFamily="{StaticResource MegasDisplayFontFamily}"
                                       FontSize="24"
                                       FontWeight="Bold" />
                            <Border Style="{StaticResource SuccessPillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="AUTHORITATIVE CORE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MegasSuccessBadgeTextBrush}" CharacterSpacing="30" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Local testing workspaces, loopback runtimes, hardware ADB, and embedded Megas MCP are inspected and ready for agent execution."
                                   FontFamily="{StaticResource MegasUiFontFamily}"
                                   FontSize="13"
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Border Style="{StaticResource PillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE77B;" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.AccountDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.McpStripText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LocalLatencyText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- CleanMyMac Giant Pill Action Button -->
                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                Style="{StaticResource CleanScanButtonStyle}"
                                AutomationProperties.Name="Run smart preflight check and inspect all surfaces">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="#001116" />
                                <TextBlock Text="RUN PREFLIGHT" FontSize="13" FontWeight="Bold" Foreground="#001116" CharacterSpacing="40" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Inspects all 4 surfaces"
                                   FontSize="11"
                                   Foreground="{ThemeResource MegasMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Error InfoBar if required -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     IsClosable="False"
                     Title="MegasMoves requires attention"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     CornerRadius="10"
                     AutomationProperties.Name="MegasMoves overview failure"
                     AutomationProperties.LiveSetting="Assertive" />

            <!-- 2. Dashboard Tiles (CleanMyMac-style 4-tile squircle grid) -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tile 1: Workspace Projects -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{ThemeResource MegasAccentSoftBrush}"
                                    HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource MegasAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SuccessPillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="5" Height="5" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="READY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MegasSuccessBadgeTextBrush}" CharacterSpacing="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.TrustedProjectCount, Mode=OneWay}"
                                       FontFamily="{StaticResource MegasDisplayFontFamily}"
                                       FontSize="30"
                                       FontWeight="Bold" />
                            <TextBlock Text="Trusted Projects"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Local testing workspaces"
                                       FontSize="12"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Health micro-meter -->
                        <Border Height="3" CornerRadius="1.5" Background="{ThemeResource MegasAccentBrush}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tile 2: Runtime Services -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{ThemeResource MegasSuccessBadgeBgBrush}"
                                    HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource MegasSuccessBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SuccessPillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="5" Height="5" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="LOOPBACK" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MegasSuccessBadgeTextBrush}" CharacterSpacing="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.RunningProjectCount, Mode=OneWay}"
                                       FontFamily="{StaticResource MegasDisplayFontFamily}"
                                       FontSize="30"
                                       FontWeight="Bold" />
                            <TextBlock Text="Running Services"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.RuntimeStripText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Health micro-meter -->
                        <Border Height="3" CornerRadius="1.5" Background="{ThemeResource MegasSuccessBrush}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tile 3: Attached Devices -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{ThemeResource MegasAccentSoftBrush}"
                                    HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8EA;" FontSize="18" Foreground="{ThemeResource MegasAccentStrongBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SuccessPillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="5" Height="5" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="ADB" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MegasSuccessBadgeTextBrush}" CharacterSpacing="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.ReadyDeviceCount, Mode=OneWay}"
                                       FontFamily="{StaticResource MegasDisplayFontFamily}"
                                       FontSize="30"
                                       FontWeight="Bold" />
                            <TextBlock Text="Attached Devices"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.AdbState, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Health micro-meter -->
                        <Border Height="3" CornerRadius="1.5" Background="{ThemeResource MegasAccentStrongBrush}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tile 4: Embedded Megas MCP Core -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{ThemeResource MegasAccentSoftBrush}"
                                    HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource MegasAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PillBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="5" Height="5" Fill="{ThemeResource MegasAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="2026-07-28" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MegasBadgeTextBrush}" CharacterSpacing="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.ConnectedAgentCount, Mode=OneWay}"
                                       FontFamily="{StaticResource MegasDisplayFontFamily}"
                                       FontSize="30"
                                       FontWeight="Bold" />
                            <TextBlock Text="Connected Agents"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.RuntimeStripText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Health micro-meter -->
                        <Border Height="3" CornerRadius="1.5" Background="{ThemeResource MegasAccentBrush}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. CANONICAL PIPELINE (Operational Workspace Area) -->
            <Border Style="{StaticResource StatCardStyle}" Padding="22,18">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource MegasAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="CANONICAL PIPELINE"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SuccessPillBadgeBorderStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="AUTHORITATIVE SESSION"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource MegasSuccessBadgeTextBrush}"
                                           CharacterSpacing="20"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="340" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTaskText, Mode=OneWay}"
                                       FontFamily="{StaticResource MegasDisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Current canonical task or operation" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.AccountDisplay, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource MegasMutedBrush}" />
                                <TextBlock Text="·" Foreground="{ThemeResource MegasMutedBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.McpStripText, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource MegasMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                    AutomationProperties.Name="Inspect active operation">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="11" />
                                    <TextBlock Text="Inspect" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Operational Bounded Steps -->
                    <Border Padding="16,12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Inspect" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasSuccessBrush}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource MegasSuccessBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Plan" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasSuccessBrush}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource MegasSuccessBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Edit" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MegasSuccessBrush}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource MegasSuccessBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Build" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource MegasAccentBrush}" />
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource MegasAccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Test" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                <Ellipse Width="6" Height="6" Stroke="{ThemeResource MegasMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Verify" FontSize="11" Foreground="{ThemeResource MegasMutedBrush}" />
                                <Ellipse Width="6" Height="6" Stroke="{ThemeResource MegasMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. ATTENTION REQUIRED (Visible only when needed) -->
            <Border Style="{StaticResource StatCardStyle}"
                    BorderBrush="{ThemeResource MegasWarningBrush}"
                    Visibility="{x:Bind AttentionVisibility, Mode=OneWay}"
                    Padding="22,18">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource MegasWarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="ATTENTION REQUIRED"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource MegasWarningBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}">
                            <TextBlock Text="{x:Bind ViewModel.NeedsYouCount, Mode=OneWay}"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{ThemeResource MegasBadgeTextBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.NeedsYou, Mode=OneWay}"
                                   AutomationProperties.Name="Items requiring human attention">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttentionItemViewModel">
                                <Border Style="{StaticResource DesktopTableRowBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource MegasWarningBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource MegasMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeBorderStyle}">
                                            <TextBlock Text="{x:Bind Source}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MegasBadgeTextBrush}" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- 5. RECENT ACTIVITY & AUDIT TRAIL -->
            <Border Style="{StaticResource StatCardStyle}" Padding="22,18">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource MegasAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="ACTIVITY &amp; AUDIT TRAIL"
                                       FontFamily="{StaticResource MegasUiFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource MegasMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="View full stream →"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="ViewAllActivity_Click"
                                FontSize="11" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}"
                                   AutomationProperties.Name="Recent activity items">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityItemViewModel">
                                <Border Padding="8,10"
                                        BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" MinWidth="220" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Time}"
                                                   FontSize="11"
                                                   FontFamily="{StaticResource MegasMonoFontFamily}"
                                                   Foreground="{ThemeResource MegasMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource PillBadgeBorderStyle}" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Source}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MegasBadgeTextBrush}" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Message}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource MegasTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind Operation}"
                                                   FontSize="10"
                                                   FontFamily="{StaticResource MegasMonoFontFamily}"
                                                   Foreground="{ThemeResource MegasMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Clean empty state for activity -->
                    <Border Visibility="{x:Bind NoActivityVisibility, Mode=OneWay}"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="System healthy: all operations and background streams running nominally."
                                       FontSize="12"
                                       Foreground="{ThemeResource MegasMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
