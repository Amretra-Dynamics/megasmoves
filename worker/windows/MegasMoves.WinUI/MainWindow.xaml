<Window
    x:Class="MegasMoves.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ShellRoot" Background="{ThemeResource MegasSurfaceBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K"
                                 Modifiers="Control"
                                 Invoked="CommandCenter_AcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellWidthStates">
                <VisualState x:Name="CompactShell">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleColumn.Width" Value="Auto" />
                        <Setter Target="AccountColumn.Width" Value="0" />
                        <Setter Target="AccountCluster.Visibility" Value="Collapsed" />
                        <Setter Target="CommandCenter.Margin" Value="8,0" />
                        <Setter Target="CommandCenter.MinWidth" Value="160" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideShell">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="920" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleColumn.Width" Value="230" />
                        <Setter Target="AccountColumn.Width" Value="Auto" />
                        <Setter Target="AccountCluster.Visibility" Value="Visible" />
                        <Setter Target="CommandCenter.Margin" Value="20,0" />
                        <Setter Target="CommandCenter.MinWidth" Value="240" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Title bar with subtle branding and centered command box -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="14,0,154,0"
              Background="{ThemeResource MegasWorkbenchChromeBrush}"
              BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleColumn" Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AccountColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="MegasMoves"
                           FontFamily="{StaticResource MegasUiFontFamily}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{ThemeResource MegasMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <AutoSuggestBox x:Name="CommandCenter"
                            Grid.Column="1"
                            Style="{StaticResource WorkbenchCommandBoxStyle}"
                            Margin="20,0"
                            PlaceholderText="Search or Jump to... (Ctrl+K)"
                            TextChanged="CommandCenter_TextChanged"
                            SuggestionChosen="CommandCenter_SuggestionChosen"
                            QuerySubmitted="CommandCenter_QuerySubmitted"
                            AutomationProperties.Name="MegasMoves command center" />

            <StackPanel x:Name="AccountCluster"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <ProgressRing Width="16"
                              Height="16"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              AutomationProperties.Name="MegasMoves operation in progress" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Click="ThemeToggle_Click"
                        ToolTipService.ToolTip="Toggle theme (Light / Dark)"
                        AutomationProperties.Name="Toggle theme">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="13" Foreground="{ThemeResource MegasMutedBrush}" />
                </Button>
                <Button Style="{StaticResource ProfileChipButtonStyle}"
                        Click="AccountButton_Click"
                        AutomationProperties.Name="Account authorization"
                        ToolTipService.ToolTip="Account authorization">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="4" Background="{ThemeResource MegasAccentSoftBrush}">
                            <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="{ThemeResource MegasAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.AccountDisplay, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   MaxWidth="130"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace Shell -->
        <NavigationView x:Name="Navigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="230"
                        CompactPaneLength="230"
                        SelectionChanged="Navigation_SelectionChanged"
                        PaneOpened="Navigation_PaneOpened"
                        PaneClosed="Navigation_PaneClosed"
                        Background="{ThemeResource MegasWorkbenchPanelBrush}"
                        AutomationProperties.Name="MegasMoves primary navigation">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,16,18,14" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource MegasAccentSoftBrush}">
                        <Image Source="ms-appx:///Assets/app-32.png"
                               Width="16"
                               Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MEGAS MOVES"
                                   FontFamily="{StaticResource MegasDisplayFontFamily}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   CharacterSpacing="40" />
                        <TextBlock Text="Local Operator"
                                   FontSize="10"
                                   Foreground="{ThemeResource MegasMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="WORKBENCH" />
                <NavigationViewItem Content="Overview" Tag="overview" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Operations" Tag="operations">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Agents" Tag="agents">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Devices" Tag="devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EA;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Runtime" Tag="runtime">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tests" Tag="tests">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemHeader Content="SYSTEM" />
                <NavigationViewItem Content="Account" Tag="account">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE779;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontSize="14" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"
                   Background="Transparent"
                   AutomationProperties.Name="MegasMoves current surface" />
        </NavigationView>

        <!-- Status footer with sleek Zed/Linear developer strip -->
        <Grid Grid.Row="2"
              Padding="12,0,12,0"
              Background="{ThemeResource MegasWorkbenchStatusBrush}"
              BorderBrush="{ThemeResource MegasWorkbenchLineBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,0,0">
                <Ellipse Width="5" Height="5" Fill="{ThemeResource MegasSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{ThemeResource MegasMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Current MegasMoves status"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="MegasMoves permanent system status">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource WorkbenchStatusButtonStyle}"
                            Click="McpStatus_Click"
                            AutomationProperties.Name="Megas MCP status"
                            ToolTipService.ToolTip="Megas MCP protocol &amp; connection status">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5"
                                     Height="5"
                                     Fill="{ThemeResource MegasSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.McpStripText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="·" Foreground="{ThemeResource MegasWorkbenchLineBrush}" FontSize="10" VerticalAlignment="Center" Margin="2,0" />
                    <Button Style="{StaticResource WorkbenchStatusButtonStyle}"
                            Click="RuntimeStatus_Click"
                            AutomationProperties.Name="Runtime status"
                            ToolTipService.ToolTip="Local process &amp; runtime service health">
                        <TextBlock Text="{x:Bind ViewModel.RuntimeStripText, Mode=OneWay}" />
                    </Button>
                    <TextBlock Text="·" Foreground="{ThemeResource MegasWorkbenchLineBrush}" FontSize="10" VerticalAlignment="Center" Margin="2,0" />
                    <Button Style="{StaticResource WorkbenchStatusButtonStyle}"
                            Click="DatabaseStatus_Click"
                            AutomationProperties.Name="Database status"
                            ToolTipService.ToolTip="Local persistence &amp; SQLite WAL state">
                        <TextBlock Text="{x:Bind ViewModel.DbStripText, Mode=OneWay}" />
                    </Button>
                    <TextBlock Text="·" Foreground="{ThemeResource MegasWorkbenchLineBrush}" FontSize="10" VerticalAlignment="Center" Margin="2,0" />
                    <Button Style="{StaticResource WorkbenchStatusButtonStyle}"
                            Click="LatencyStatus_Click"
                            AutomationProperties.Name="Local control latency"
                            ToolTipService.ToolTip="Local Named Pipe control plane round-trip latency">
                        <TextBlock Text="{x:Bind ViewModel.LocalLatencyText, Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
