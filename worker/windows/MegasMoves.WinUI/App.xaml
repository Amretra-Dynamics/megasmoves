                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#001116" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#001116" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#001116" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />

                    <!-- Built-in navigation item overrides -->
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00DCE8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1A00DCE8" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#00DCE8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#14FFFFFF" />
                </ResourceDictionary>

