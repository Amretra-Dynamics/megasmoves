<Application
    x:Class="MegasMoves.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MegasMoves design system: quiet Windows-native neutrals with one
                 product accent. Shell/workbench resources deliberately reuse the
                 same identity instead of introducing a second prototype theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- MegasMoves Canonical Palette (Obsidian Dark) -->
                    <SolidColorBrush x:Key="MegasAccentBrush" Color="#00DCE8" />
                    <SolidColorBrush x:Key="MegasAccentStrongBrush" Color="#21B7FF" />
                    <SolidColorBrush x:Key="MegasAccentSoftBrush" Color="#1A00DCE8" />
                    <SolidColorBrush x:Key="MegasSurfaceBrush" Color="#030810" />
                    <SolidColorBrush x:Key="MegasCardBrush" Color="#07111C" />
                    <SolidColorBrush x:Key="MegasBorderBrush" Color="#1B3040" />
                    <SolidColorBrush x:Key="MegasTextBrush" Color="#F4F7F8" />
                    <SolidColorBrush x:Key="MegasTextSoftBrush" Color="#C7D1D6" />
                    <SolidColorBrush x:Key="MegasMutedBrush" Color="#91A1AA" />
                    <SolidColorBrush x:Key="MegasSuccessBrush" Color="#18D889" />
                    <SolidColorBrush x:Key="MegasWarningBrush" Color="#FF9A3D" />
                    <SolidColorBrush x:Key="MegasDangerBrush" Color="#FF6F70" />

                    <!-- Materials and background -->
                    <SolidColorBrush x:Key="MegasCardGlassBrush" Color="#0A1624" />
                    <SolidColorBrush x:Key="MegasCardGlassBorderBrush" Color="#1B3040" />
                    <SolidColorBrush x:Key="MegasHeroGlassBrush" Color="#0D1E30" />
                    <SolidColorBrush x:Key="MegasPillBrush" Color="#1A00DCE8" />
                    <SolidColorBrush x:Key="MegasTitleBarGlassBrush" Color="#050C16" />

                    <SolidColorBrush x:Key="MegasWorkbenchChromeBrush" Color="#050C16" />
                    <SolidColorBrush x:Key="MegasWorkbenchPanelBrush" Color="#040A14" />
                    <SolidColorBrush x:Key="MegasWorkbenchLineBrush" Color="#1B3040" />
                    <SolidColorBrush x:Key="MegasWorkbenchHoverBrush" Color="#1400DCE8" />
                    <SolidColorBrush x:Key="MegasWorkbenchSelectedBrush" Color="#2600DCE8" />
                    <SolidColorBrush x:Key="MegasWorkbenchStatusBrush" Color="#040A13" />

                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#07111C" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0A1824" />

                    <!-- CleanMyMac Iconic Gradient Brushes -->
                    <LinearGradientBrush x:Key="MegasAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00DCE8" Offset="0.0" />
                        <GradientStop Color="#21B7FF" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MegasHeroGlassGradientBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D2034" Offset="0.0" />
                        <GradientStop Color="#06101B" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MegasDialGlowBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4D00DCE8" Offset="0.0" />
                        <GradientStop Color="#1A21B7FF" Offset="0.5" />
                        <GradientStop Color="#0500DCE8" Offset="1.0" />
                    </LinearGradientBrush>

                    <!-- Status Badges -->
                    <SolidColorBrush x:Key="MegasBadgeBgBrush" Color="#0A1824" />
                    <SolidColorBrush x:Key="MegasBadgeBorderBrush" Color="#1B3040" />
                    <SolidColorBrush x:Key="MegasBadgeTextBrush" Color="#C7D1D6" />
                    <SolidColorBrush x:Key="MegasSuccessBadgeBgBrush" Color="#1A18D889" />
                    <SolidColorBrush x:Key="MegasSuccessBadgeBorderBrush" Color="#3318D889" />
                    <SolidColorBrush x:Key="MegasSuccessBadgeTextBrush" Color="#18D889" />

                    <!-- Control styling overrides -->
                    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="NavigationViewItemCornerRadius">6</CornerRadius>

                    <!-- Built-in button overrides -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#0A1824" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#102231" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#152B3C" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#F4F7F8" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1B3040" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#334B5D" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00DCE8" />

                    <!-- Built-in accent button overrides -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#00DCE8" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#21B7FF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#00B4C0" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#001116" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#001116" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#001116" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />

                    <!-- Built-in navigation item overrides -->
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00DCE8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1A00DCE8" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#00DCE8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#14FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- MegasMoves Canonical Palette (Obsidian Dark) -->
                    <SolidColorBrush x:Key="MegasAccentBrush" Color="#00DCE8" />
