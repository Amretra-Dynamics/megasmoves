            <FontFamily x:Key="MegasUiFontFamily">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="MegasDisplayFontFamily">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="MegasMonoFontFamily">Cascadia Mono, Cascadia Code</FontFamily>

            <!-- Desktop Spatial System: Calm surfaces, subtle separators, high information density -->
            <Style x:Key="DesktopSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MegasCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MegasWorkbenchLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="DesktopSeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource MegasWorkbenchLineBrush}" />
                <Setter Property="Margin" Value="0,6" />
            </Style>

            <Style x:Key="DesktopTableRowBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource MegasWorkbenchLineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- Card and Widget styles (CleanMyMac-inspired squircle cards) -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MegasCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MegasWorkbenchLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="StatCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MegasCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MegasWorkbenchLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18,16" />
            </Style>

            <Style x:Key="HeroCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MegasHeroGlassGradientBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MegasCardGlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="28,24" />
            </Style>

            <!-- Megas Status Badges (Clean, proportioned pill capsules) -->
            <Style x:Key="BadgeBorderStyle" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource MegasBadgeBorderBrush}" />
                <Setter Property="Background" Value="{ThemeResource MegasBadgeBgBrush}" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PillBadgeBorderStyle" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource MegasBadgeBorderBrush}" />
                <Setter Property="Background" Value="{ThemeResource MegasBadgeBgBrush}" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
