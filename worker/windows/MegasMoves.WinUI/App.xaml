                    <!-- Control styling overrides -->
                    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="NavigationViewItemCornerRadius">6</CornerRadius>

                    <!-- Built-in button overrides -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#0A1824" />
