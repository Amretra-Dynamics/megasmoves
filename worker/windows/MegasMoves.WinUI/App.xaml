                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- CleanMyMac Iconic Scan Pill Button -->
            <Style x:Key="CleanScanButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="46" />
                <Setter Property="Padding" Value="32,0" />
                <Setter Property="CornerRadius" Value="23" />
                <Setter Property="Background" Value="{ThemeResource MegasAccentGradientBrush}" />
                <Setter Property="Foreground" Value="#001116" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontFamily" Value="{StaticResource MegasUiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Global Implicit Button Style: Native Windows 11 Desktop -->
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="{StaticResource MegasUiFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

