  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Grant an enabled, exact saved-skill revision for day and/or overnight work toward a local goal. The owner-authored objective is delivered to each named local review worker in the pinned skill for its registered repository. A null phase grants nothing. Defaults to once per phase. Optionally repeat every requested number of minutes in a phase; missed cycles do not backfill. An explicit local until_task_id ends the goal when its completion is recorded. Runs while this operator is online.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                },
                "skill_id": {
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$",
                  "type": "string"
                }
              },
              "required": [
                "skill_id",
                "revision"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "day_every_minutes": {
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        },
        "expected_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "goal_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "type": "string"
        },
        "objective": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "overnight": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                },
                "skill_id": {
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$",
                  "type": "string"
                }
              },
              "required": [
                "skill_id",
                "revision"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "overnight_every_minutes": {
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        },
        "unattended_granted": {
          "const": true
        },
        "until_task_id": {
          "pattern": "^task_[a-f0-9]{32}$",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "objective",
        "day",
        "overnight",
        "unattended_granted",
        "expected_revision"
      ],
      "type": "object"
    },
    "name": "megas_auto_routine_save"
  },
