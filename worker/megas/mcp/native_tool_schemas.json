    },
    "description": "Inspect the current owner graphical session, native dependencies, Operate gate and session lock readiness without reading window content or changing focus. Session readiness does not certify application accessibility. X11 only; no Wayland or simulated fallback.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "name": "linux_desktop_status",
    "title": "Linux desktop capability status"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Create a real Megas work-notes window on the owner desktop without taking focus. Default open with no arguments creates one window. To reuse that exact window, pass its private resume_token, including across MCP reconnects. To replace and verify its plain-text note use action=write with token and text. To read back the actual note through native accessibility, use action=read with the token. To close use action=release with token. The owner can close it, or it expires after one hour unused. List other windows and their background-use options with linux_ui_windows. Generic application windows can be inspected using linux_ui_inspect_window. Keep tokens out of user-visible summaries.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "open",
            "read",
            "write",
            "release"
          ],
          "type": "string"
        },
        "resume_token": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "text": {
          "maxLength": 8192,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "linux_ui_agent_window",
    "title": "Open, reuse, update or release a background agent work window"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Inspect bounded accessibility controls from one exact, freshly listed OS window without activating it. The installed operator rechecks the desktop session, process birth and window geometry.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "max_nodes": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "window_index": {
          "maximum": 99,
          "minimum": 0,
          "type": "integer"
        },
        "window_list_id": {
          "maxLength": 128,
          "minLength": 20,
          "type": "string"
        }
      },
      "required": [
        "window_list_id",
        "window_index"
      ],
      "type": "object"
    },
    "name": "linux_ui_inspect_window",
    "title": "Inspect one listed Linux window without focus"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List owner X11 windows without activation. Each row carries its own window_ref, occupancy, operations and background_use. Managed windows also carry the public agent_window_id and creating client when known. Pass agent_window_id or window_ref from a work-window receipt to find that exact live window regardless of title. To inspect it, pass window_list_id and the matching row’s index as window_index to linux_ui_inspect_window before the listing expires. Resume or update your managed window with its private token. Recent session input has no actor attribution. Requires owner-enabled Operate.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "agent_window_id": {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        "window_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "linux_ui_windows",
    "title": "List Linux windows"
  },
