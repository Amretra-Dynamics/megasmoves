{
  "manifest_version": 3,
  "name": "MegasMoves Browser",
  "version": "0.1.0",
  "description": "Control only browser tabs you explicitly grant to your local MegasMoves agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MegasMoves Browser",
    "default_popup": "popup.html"
  }
}
