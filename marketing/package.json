{
  "name": "megas-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "billing:env:check": "node --env-file=.env.local scripts/check-billing-env-v2.mjs test",
    "billing:env:check:production": "node --env-file=.env.production scripts/check-billing-env-v2.mjs live",
    "test:visual": "playwright test tests/landing.visual.spec.ts tests/authenticated-ui.visual.spec.ts",
    "test:visual:headed": "playwright test tests/landing.visual.spec.ts tests/authenticated-ui.visual.spec.ts --headed"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.15",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
